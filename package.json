{
  "name": "steward",
  "version": "1.0.0",
  "private": true,
  "description": "When plans break, Steward fixes them.",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test test/*.test.js",
    "check": "node --check server.js && node --check sandbox-server.js && node --check public/app.js",
    "test:e2e": "playwright test",
    "format": "prettier --write server.js sandbox-server.js src public test e2e scripts playwright.config.js",
    "format:check": "prettier --check server.js sandbox-server.js src public test e2e scripts playwright.config.js",
    "record:demo": "node scripts/record-demo.js",
    "sandbox": "node --env-file-if-exists=.env sandbox-server.js",
    "phone:gateway": "node --env-file-if-exists=.env scripts/phone-gateway.js",
    "test:v2": "node scripts/v2-e2e.js",
    "test:v2:mobile": "node scripts/v2-mobile.js",
    "scan:public": "node scripts/public-secret-scan.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "agentmail": "^0.5.35"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "ffmpeg-static": "^5.3.0",
    "prettier": "^3.9.9",
    "qrcode": "^1.5.4"
  }
}
