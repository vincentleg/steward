{
  "name": "steward",
  "version": "1.0.0",
  "private": true,
  "description": "When plans break, Steward fixes them.",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test test/*.test.js",
    "check": "node --check server.js && node --check public/app.js",
    "test:e2e": "playwright test",
    "format": "prettier --write server.js src public test e2e scripts playwright.config.js",
    "format:check": "prettier --check server.js src public test e2e scripts playwright.config.js",
    "record:demo": "node scripts/record-demo.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "agentmail": "^0.5.35"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.9"
  }
}
