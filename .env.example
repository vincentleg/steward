# Copy to .env; never commit .env. All secrets remain server-side.
PORT=3000
# Public HTTPS origin reachable from Vincent's phone (no trailing slash).
PUBLIC_BASE_URL=
# Existing inbox is hardcoded: steward-agent@agentmail.to. No new inbox is created.
AGENTMAIL_API_KEY=
# Real recipient for the approval email.
APPROVAL_EMAIL=
# Set to a random 32-byte value in production. Local default persists in .data/.
APPROVAL_SECRET=
# Optional: 1 is normal demo pacing. Tests can use 0.1.
WORKFLOW_PACE=1

# Anonymous synthetic service, separate from LIVE email.
SANDBOX_PORT=3003
SANDBOX_PACE=1.5
# Optional separate persistent directory (used by isolated browser tests).
# DATA_DIR=.data

# Private local server binds loopback. Containers may set 0.0.0.0 behind an authenticated gateway.
BIND_HOST=127.0.0.1

# Phase 6 private development ONLY. Public connected mode is not enabled.
# 32-byte application encryption key, base64; never put personal Google tokens here.
CONNECTION_ENCRYPTION_KEY=
CONNECTED_PORT=3406
CONNECTED_ORIGIN=http://localhost:3406
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
