# Copy to .env; never commit .env. All secrets remain server-side.
PORT=3000
# Public HTTPS origin reachable from Vincent's phone (no trailing slash).
PUBLIC_BASE_URL=
# Existing inbox is hardcoded: steward-agent@agentmail.to. No new inbox is created.
AGENTMAIL_API_KEY=
# Real recipient for the approval email.
APPROVAL_EMAIL=
# Set to a random 32-byte value in production. Local default persists in .data/.
APPROVAL_SECRET=
# Optional: 1 is normal demo pacing. Tests can use 0.1.
WORKFLOW_PACE=1
